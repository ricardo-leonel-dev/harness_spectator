PORT=4000
DATABASE_URL=postgres://ricardoaguilar@localhost/harness_dev?host=/tmp
FRONTEND_ORIGIN=http://localhost:4200

# Auth mode: `supabase` (default when unset or empty) or `local`.
AUTH_MODE=supabase

# Supabase mode: required.
SUPABASE_JWT_SECRET=replace-with-supabase-project-jwt-secret

# Local mode (AUTH_MODE=local): SUPABASE_JWT_SECRET is not needed; these are.
# In supabase mode the LOCAL_AUTH_* variables are not read at all.
# AUTH_MODE=local
# LOCAL_AUTH_SECRET=replace-with-at-least-32-random-bytes-eg-openssl-rand-base64-48
# Generate each hash with: read -rs PW && printf '%s\n' "$PW" | cargo run --bin hash-password
# Keep the single quotes: without them dotenvy expands every `$` in the hash.
# Entries are `<email>:<argon2id hash>`, separated by `;` (one per line inside the quotes works too).
# LOCAL_AUTH_USERS='alice@example.com:$argon2id$v=19$m=19456,t=2,p=1$...;bob@example.com:$argon2id$...'
# Token lifetime in seconds, 60..=86400 (default 3600).
# LOCAL_AUTH_TOKEN_TTL_SECONDS=3600
